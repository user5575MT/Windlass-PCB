(global_label "REED_GPIO" (shape passive) (at 107.95 80.01 0) (effects (font (size 1.27 1.27)) (justify right bottom)) (uuid "ed7b9d15-d6ce-41a6-a04f-0827aa8cfcfc"))
(text "J_USB is a GCT USB4105 top-mount receptacle. Every signal pad is on the board. The earlier mid-mount HRO part is not used.\\nCC resistors are 5.1k Rd. D+ and D- have 22 ohm series resistors, then USBLC6-2SC6. Its VBUS pin is USB_VBUS, not +3V3.\\nR13 and R14 hold the coil requests low while the GPIOs are high-Z, including reset." (at 20 40 0) (effects (font (size 1.27 1.27))) (uuid "8169dca0-f0d4-456e-b173-c76ae86fa7fd"))
  (embedded_fonts no)
)
