(global_label "DN_RET" (shape passive) (at 80.01 104.14 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "cc1de2bf-3d43-46e6-8314-ede2c8d66bda"))
(text "TLP291(GB-TP,SE): pin 1 anode, pin 2 cathode, pin 3 emitter, pin 4 collector.\\nEmitter is board GND. Collector is the GPIO with a 10k pull-up to 3.3 V. LED on pulls the GPIO low, which is what the existing firmware treats as active.\\n1N4148 is anti-parallel across the LED. 100 nF is across the LED. There is no isolated supply on these channels." (at 20 40 0) (effects (font (size 1.27 1.27))) (uuid "1b33c8d8-d411-42e3-8147-e71a963f998b"))
  (embedded_fonts no)
)
